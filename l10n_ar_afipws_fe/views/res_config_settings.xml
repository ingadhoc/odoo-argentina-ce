<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.account</field>
            <field name="model">res.config.settings</field>
            <field eval="40" name="priority"/>
            <field name="inherit_id" ref="l10n_ar_afipws.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <field name="afip_ws_env_type" position="attributes">
                    <attribute name="class">font-weight-bold ms-4</attribute>
                </field>
                <xpath expr="//block[@id='invoicing_settings']/setting[@type='header']" position="attributes">
                    <attribute name="type">setting</attribute>
                </xpath>
                <xpath expr="//block[@id='invoicing_settings']" position="inside">
                    <block title="Electronic Invoice AFIP (ARCA)" name="afip_fe_settings_container">
                        <setting string="FCE MiPyME Transmission" id="afip_fe_fce_transmission_setting">
                            <field name="l10n_ar_afip_fce_transmission" widget="radio"/>
                            <div class="text-muted" style="margin-top:8px;">
                                This information will be sent to AFIP by default when validating FCE documents. RG 4919/2021 requirement.
                            </div>
                        </setting>
                        <setting string="Foreign Currency Payments" id="afip_fe_foreign_currency_setting">
                            <field name="l10n_ar_payment_foreign_currency" widget="radio"/>
                            <div class="text-muted" style="margin-top:8px;">
                                <p>
                                    Please select the default option that will be used to inform ARCA whether the payment will be made in foreign currency, as required by RG 5616/2024:
                                </p>
                                <ul class="mb-0">
                                    <li><strong>Yes</strong>: Will always inform ARCA that payments are made in foreign currency.</li>
                                    <li><strong>No</strong>: By default, will not report payments as foreign currency.</li>
                                    <li><strong>Account's Currency Dependant</strong>: The information sent to ARCA will depend on the currency configured in the receivable account used in the transaction.</li>
                                </ul>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
