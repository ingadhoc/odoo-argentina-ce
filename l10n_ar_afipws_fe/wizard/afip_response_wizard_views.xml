<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_afip_response_wizard_form" model="ir.ui.view">
        <field name="name">afip.response.wizard.form</field>
        <field name="model">afip.response.wizard</field>
        <field name="arch" type="xml">
            <form string="Respuesta AFIP">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="title" readonly="1" nolabel="1"/>
                        </h1>
                    </div>
                    <field name="html_content" nolabel="1" widget="html"/>
                </sheet>
                <footer>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
