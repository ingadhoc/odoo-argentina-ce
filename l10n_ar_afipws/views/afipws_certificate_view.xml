<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_afipws_certificate_form" model="ir.ui.view">
        <field name="name">afipws.certificate.form</field>
        <field name="model">afipws.certificate</field>
        <field name="arch" type="xml">
            <form string="AFIP Certificates">
                <header>
                    <button name="%(action_upload_certificate)d"
                        type="action"
                        invisible="state != 'draft'"
                        class="oe_highlight"
                        string="Upload Certificate"/>
                    <button name="action_confirm"
                        type="object"
                        invisible="state != 'draft'"
                        string="Confirm"/>
                    <button name="action_to_draft"
                        type="object"
                        invisible="state != 'cancel'"
                        string="To Draft"/>
                    <button name="action_cancel"
                        type="object"
                        invisible="state not in ('draft', 'confirmed')"
                        string="Cancel"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <div class="alert alert-danger" role="alert" invisible="not cert_is_expired or state != 'confirmed'">
                    <strong>⚠ Certificado Vencido</strong> - Este certificado expiró el <field name="cert_valid_to" readonly="1"/>
                </div>
                <div class="alert alert-warning" role="alert" invisible="cert_is_expired or cert_days_to_expire > 30 or cert_days_to_expire == 0 or state != 'confirmed'">
                    <strong>⚠ Certificado próximo a vencer</strong> - Este certificado expira en <field name="cert_days_to_expire" readonly="1"/> días
                </div>
                <sheet string="AFIP Certificates">
                    <group>
                        <field name="csr" groups="base.group_no_one" readonly="state != 'draft'"/>
                        <field name="request_filename" invisible="1"/>
                        <field name="request_file" readonly="state != 'draft'" filename="request_filename"/>
                        <field name="crt" groups="base.group_no_one" readonly="state != 'draft'"/>
                    </group>
                    <group string="Información del Certificado" invisible="not crt">
                        <group>
                            <field name="cert_valid_from" readonly="1"/>
                            <field name="cert_valid_to" readonly="1"/>
                            <field name="cert_days_to_expire" readonly="1" invisible="cert_days_to_expire == 0"/>
                            <field name="cert_is_expired" invisible="1"/>
                        </group>
                        <group>
                            <field name="cert_serial_number" readonly="1"/>
                            <field name="cert_subject" readonly="1"/>
                            <field name="cert_issuer" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_afipws_certificate_tree" model="ir.ui.view">
        <field name="name">afipws.certificate.list</field>
        <field name="model">afipws.certificate</field>
        <field name="arch" type="xml">
            <list string="AFIP Certificates">
                <field name="alias_id"/>
                <field name="create_date"/>
                <field name="cert_valid_to"/>
                <field name="cert_days_to_expire" optional="show"/>
                <field name="cert_is_expired" invisible="1"/>
                <field name="state" decoration-danger="cert_is_expired and state == 'confirmed'" decoration-warning="cert_days_to_expire > 0 and cert_days_to_expire &lt; 30 and state == 'confirmed'"/>
            </list>
        </field>
    </record>
</odoo>
