<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="account_vat_ledger_tree">
        <field name="name">account.vat.ledger.list</field>
        <field name="model">account.vat.ledger</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="first_page"/>
                <field name="last_page"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="account_vat_ledger_form">
        <field name="name">account.vat.ledger.form</field>
        <field name="model">account.vat.ledger</field>
        <field name="arch" type="xml">
            <form string="Libro de IVA">
                <field name="type" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <header>
                    <button name="action_print" string="Imprimir" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_print" string="Imprimir" type="object" invisible="state == 'draft'"/>
                    <button name="action_present" string="Presentar" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state == 'cancel'"/>
                    <button name="action_to_draft" string="Volver a borrador" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,presented"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" widget="selection" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="date_from" string="Fecha desde" readonly="state != 'draft'"/>
                            <field name="date_to" string="Fecha hasta" readonly="state != 'draft'"/>
                            <field name="presented_ledger_name" invisible="1"/>
                            <field name="presented_ledger" filename="presented_ledger_name" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="first_page" string="Primera página" readonly="state != 'draft'"/>
                            <field name="last_page" string="Última página" readonly="state != 'draft'"/>
                            <field name="prorate_tax_credit" string="Prorratear crédito fiscal" readonly="state != 'draft'"/>
                            <field name="prorate_type" string="Tipo de prorrateo" invisible="not prorate_tax_credit" required="prorate_tax_credit" readonly="state != 'draft'"/>
                            <field name="reference" string="Referencia" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Comprobantes" name="invoices">
                            <field name="invoice_ids" readonly="1"/>
                        </page>
                        <page string="Diarios" name="journal_ids">
                            <field name="journal_ids" readonly="state != 'draft'" domain="[('type', '=', type), ('company_id', '=', company_id), ('l10n_latam_use_documents', '=', True)]"/>
                        </page>
                        <page string="Archivos TXT" name="txt_files">
                            <button name="compute_txt_data" type="object" string="Calcular TXT" invisible="state != 'draft'"/>
                            <group>
                                <field name="vouchers_filename" invisible="1"/>
                                <field name="aliquots_filename" invisible="1"/>
                                <field name="import_aliquots_filename" invisible="1"/>
                                <group>
                                    <field name="vouchers_file" filename="vouchers_filename"/>
                                    <field name="aliquots_file" filename="aliquots_filename"/>
                                    <field name="import_aliquots_file" filename="import_aliquots_filename"/>
                                </group>
                            </group>
                            <group col="1" groups="base.group_no_one">
                                <field name="REGINFO_CV_CBTE"/>
                                <field name="REGINFO_CV_ALICUOTAS"/>
                                <field name="REGINFO_CV_COMPRAS_IMPORTACIONES" invisible="type != 'purchase'"/>
                            </group>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_account_purchase_vat_ledger" model="ir.actions.act_window">
        <field name="name">Libro IVA Compras</field>
        <field name="res_model">account.vat.ledger</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_type': 'purchase'}</field>
        <field name="domain">[('type', '=', 'purchase')]</field>
    </record>

    <record id="action_account_sale_vat_ledger" model="ir.actions.act_window">
        <field name="name">Libro IVA Ventas</field>
        <field name="res_model">account.vat.ledger</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_type': 'sale'}</field>
        <field name="domain">[('type', '=', 'sale')]</field>
    </record>

    <menuitem id="menu_account_purchase_vat_ledger"
        name="Libro IVA Compras"
        action="action_account_purchase_vat_ledger"
        parent="l10n_ar.account_reports_ar_statements_menu"
        sequence="6"/>

    <menuitem id="menu_account_sale_vat_ledger"
        name="Libro IVA Ventas"
        action="action_account_sale_vat_ledger"
        parent="l10n_ar.account_reports_ar_statements_menu"
        sequence="4"/>
</odoo>
