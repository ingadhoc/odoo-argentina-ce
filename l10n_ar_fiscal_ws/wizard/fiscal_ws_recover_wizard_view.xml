<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fiscal_ws_recover_form" model="ir.ui.view">
        <field name="name">l10n_ar.fiscal.ws.recover.form</field>
        <field name="model">l10n_ar.fiscal.ws.recover</field>
        <field name="arch" type="xml">
            <form string="Recuperar comprobantes">
                <field name="state" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="available_document_type_ids" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="state != 'setup'">
                    Cuando el servicio autoriza un comprobante y la respuesta no llega, el comprobante
                    queda autorizado en el organismo y no en Odoo. Este asistente pregunta por cada
                    número del rango, los compara con los borradores del diario y propone asignarlos
                    o crearlos.
                </div>
                <group invisible="state != 'setup'">
                    <group>
                        <field name="journal_id"/>
                        <field name="document_type_id"/>
                    </group>
                    <group>
                        <field name="number_from"/>
                        <field name="number_to"/>
                    </group>
                </group>
                <group invisible="state != 'review'">
                    <group>
                        <field name="journal_id" readonly="1"/>
                        <field name="document_type_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="account_id"/>
                    </group>
                </group>
                <field name="line_ids" invisible="state != 'review'" nolabel="1">
                    <list editable="bottom" create="false" delete="false"
                          decoration-muted="action == 'skip'">
                        <field name="company_id" column_invisible="1"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="number" readonly="1"/>
                        <field name="date" readonly="1"/>
                        <field name="document_number" readonly="1"/>
                        <field name="amount_total" readonly="1"/>
                        <field name="auth_code" readonly="1"/>
                        <field name="partner_id" readonly="action == 'skip'"/>
                        <field name="action"/>
                        <field name="move_id" readonly="action != 'match'"/>
                        <field name="reverse" readonly="action == 'skip'"/>
                        <field name="note" readonly="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_fetch" string="Traer del servicio" type="object"
                            class="btn-primary" invisible="state != 'setup'"/>
                    <button name="action_apply" string="Recuperar" type="object"
                            class="btn-primary" invisible="state != 'review'"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fiscal_ws_recover" model="ir.actions.act_window">
        <field name="name">Recuperar comprobantes</field>
        <field name="res_model">l10n_ar.fiscal.ws.recover</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
