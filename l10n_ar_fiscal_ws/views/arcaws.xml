<odoo>
    <record id="view_arcaws_form" model="ir.ui.view">
        <field name="name">arcaws.auth.form</field>
        <field name="model">arcaws</field>
        <field name="arch" type="xml">
            <form string="ARCA ws">
                <sheet string="WS">
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="production_url"/>
                        <field name="homologation_url"/>
                        <field name="view_id"/>
                    </group>
                        <field name="method_ids">
                            <list string="Methods" name="methods">
                                <field name="name"/>
                                <field name="model_id"/>
                                <field name="method_name"/>
                            </list>
                        </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_arcaws_tree" model="ir.ui.view">
        <field name="name">arcaws.auth.list</field>
        <field name="model">arcaws</field>
        <field name="arch" type="xml">
            <list string="ARCA WS">
                <field name="name"/>
                <field name="code"/>
                <button name="action_dummie" string="Dummy test" invisible="not dummy_method" type="object"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_arcaws">
        <field name="name">ARCA WS</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">arcaws</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_arcaws_method_form" model="ir.ui.view">
        <field name="name">arcaws.method.form</field>
        <field name="model">arcaws.method</field>
        <field name="arch" type="xml">
            <form string="ARCA WS Method">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="arcaws_id"/>
                        <field name="model_id"/>
                        <field name="method_name"/>
                        <field name="definition_dict"/>
                        <field name="response_dict"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem name="Arca WebService" action="act_arcaws" id="menu_action_arcaws_auth" parent="l10n_ar.menu_afip_config"/>

</odoo>
