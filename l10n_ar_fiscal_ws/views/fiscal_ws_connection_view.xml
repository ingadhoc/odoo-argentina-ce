<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiscal_ws_connection_form" model="ir.ui.view">
        <field name="name">l10n_ar.fiscal.ws.connection.form</field>
        <field name="model">l10n_ar.fiscal.ws.connection</field>
        <field name="arch" type="xml">
            <form string="Access Ticket">
                <sheet>
                    <group>
                        <field name="fiscal_ws_id"/>
                        <field name="type"/>
                        <field name="company_id"/>
                        <field name="unique_id"/>
                        <field name="generation_time"/>
                        <field name="expiration_time"/>
                        <field name="service_url"/>
                    </group>
                    <group string="Credentials">
                        <field name="token"/>
                        <field name="sign"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fiscal_ws_connection_list" model="ir.ui.view">
        <field name="name">l10n_ar.fiscal.ws.connection.list</field>
        <field name="model">l10n_ar.fiscal.ws.connection</field>
        <field name="arch" type="xml">
            <list string="Access Tickets" create="false" edit="false">
                <field name="fiscal_ws_id"/>
                <field name="type"/>
                <field name="generation_time"/>
                <field name="expiration_time"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_fiscal_ws_connection">
        <field name="name">Access Tickets</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">l10n_ar.fiscal.ws.connection</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Tickets de acceso" action="act_fiscal_ws_connection" id="menu_action_fiscal_ws_connection" parent="menu_fiscal_ws" sequence="30"/>

</odoo>
