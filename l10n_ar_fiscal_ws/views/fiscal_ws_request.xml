<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="login_ticket_request" name="Login Ticket Request">&lt;?xml version = "1.0" encoding = "utf-8"?&gt;
        <loginTicketRequest version="1.0">
            <header>
                <uniqueId><t t-out="unique_id"/></uniqueId>
                <generationTime><t t-out="generation_time.strftime('%Y-%m-%dT%H:%M:%S')"/></generationTime>
                <expirationTime><t t-out="expiration_time.strftime('%Y-%m-%dT%H:%M:%S')"/></expirationTime>
            </header>
            <service><t t-out="service"/></service>
        </loginTicketRequest>
    </template>
</odoo>
