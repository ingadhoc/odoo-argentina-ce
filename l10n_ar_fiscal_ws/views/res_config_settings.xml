<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account</field>
        <field name="model">res.config.settings</field>
        <field eval="40" name="priority"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting type="header" string="Web services fiscales" help="Conexión con los web services de ARCA">
                    <button class="btn-link" icon="fa-arrow-right" name="%(l10n_ar_fiscal_ws.act_fiscal_certificate_alias)d" string="Certificados" type="action"/>
                    <button class="btn-link" icon="fa-arrow-right" name="%(l10n_ar_fiscal_ws.act_fiscal_ws_connection)d" string="Tickets de acceso" type="action"/>
                    <label for="l10n_ar_fiscal_ws_env_type"/>
                    <field class="font-weight-bold" name="l10n_ar_fiscal_ws_env_type"/>
                    <label for="l10n_ar_fce_transmission_type"/>
                    <field class="font-weight-bold" name="l10n_ar_fce_transmission_type"/>
                    <label for="l10n_ar_fiscal_payment_foreign_currency"/>
                    <field class="font-weight-bold" name="l10n_ar_fiscal_payment_foreign_currency"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
